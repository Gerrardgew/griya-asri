# Salin file ini menjadi .env lalu isi nilainya. JANGAN commit .env.
#
# LOKAL (SQLite):
DATABASE_URL="file:./dev.db"
#
# PRODUKSI/Vercel (PostgreSQL, mis. Neon) — ganti baris DATABASE_URL di atas:
# DATABASE_URL="postgresql://user:pass@host/dbname?sslmode=require"

# Minimal 32 karakter acak (mis. hasil: openssl rand -base64 32)
SESSION_SECRET=""
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Kredensial akun admin tunggal, dipakai saat `npm run db:seed`
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="minimal-8-karakter"
