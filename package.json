{
  "name": "griya-asri",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node prisma/prepare-prisma.mjs && next build",
    "start": "next start",
    "db:push": "prisma db push",
    "db:seed": "node --env-file=.env prisma/seed.mjs",
    "db:push:pg": "node prisma/make-postgres-schema.mjs && prisma db push --schema prisma/schema.postgres.prisma && prisma generate --schema prisma/schema.postgres.prisma",
    "db:seed:pg": "node --env-file-if-exists=.env.production prisma/seed.mjs",
    "test:e2e": "node e2e/build.mjs && playwright test",
    "test:e2e:ui": "node e2e/build.mjs && playwright test --ui",
    "test:e2e:ci": "node e2e/build.mjs && playwright test"
  },
  "dependencies": {
    "@prisma/client": "^5.19.0",
    "bcryptjs": "^2.4.3",
    "next": "^16.3.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "prisma": "^5.19.0",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.5.4"
  }
}
